{
  "AllowedHosts": "*",
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Information"
    }
  },
  "Services": {
    "Orders": {
      "BaseUrl": "http://localhost:5041"
    }
  },
  "ReverseProxy": {
    "Routes": {
      "products": {
        "ClusterId": "products",
        "Match": { "Path": "/api/products/{**any}" }
      },
      "categories": {
        "ClusterId": "products",
        "Match": { "Path": "/api/categories/{**any}" }
      }
    },
    "Clusters": {
      "products": {
        "Destinations": {
          "default": {
            "Address": "http://localhost:5250/"
          }
        }
      }
    }
  }
}
